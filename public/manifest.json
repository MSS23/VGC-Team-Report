{
  "id": "/",
  "name": "VGC Team Report",
  "short_name": "VGC Report",
  "description": "Build, analyze, and share competitive Pokemon VGC team reports with EV spreads, damage calcs, matchup plans, and real-time collaboration.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0a0f1a",
  "theme_color": "#E11D48",
  "orientation": "any",
  "categories": ["games", "utilities", "social"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "shortcuts": [
    {
      "name": "Create Report",
      "short_name": "Create",
      "url": "/",
      "description": "Start a new VGC team report",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Explore Teams",
      "short_name": "Explore",
      "url": "/explore",
      "description": "Browse community team reports",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Champions",
      "short_name": "Champions",
      "url": "/champions",
      "description": "World Championship winning teams",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Compare Teams",
      "short_name": "Compare",
      "url": "/compare",
      "description": "Side-by-side team comparison",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "description": "Manage your reports and collaborations",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "url": "paste"
    }
  }
}
