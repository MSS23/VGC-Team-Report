# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Clerk publishable + secret keys come from the Clerk dashboard and are read by
# the @clerk/nextjs SDK directly (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY).
# They are intentionally omitted from this example to avoid them being mistaken
# for placeholders. Copy from the Clerk dashboard's "API keys" page.

# Signing secret for the /api/webhooks/clerk endpoint — required to verify
# user.created/user.updated webhooks from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cron, Cleanup & Admin ─────────────────────────────────────────────────────
# Secret for authenticating Vercel cron routes (used by daily-ops, weekly-report,
# keep-alive). Verified via crypto.timingSafeEqual.
CRON_SECRET=your-cron-secret-here

# Secret token for /api/cleanup (optional — stale share cleanup admin endpoint).
CLEANUP_SECRET=your-cleanup-secret-here

# Secret token for /api/migrate (one-shot schema migrations).
MIGRATE_SECRET=your-migrate-secret-here

# ── Linear Integration ────────────────────────────────────────────────────────
# API key from Linear Settings > API > Personal API Keys.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Linear team UUID — find via Linear API or team settings URL.
LINEAR_TEAM_ID=your-team-uuid-here

# Signing secret configured in Linear's webhook settings.
# Used by /api/webhooks/linear to verify the linear-signature HMAC.
# The legacy name LINEAR_WEBHOOK_SECRET is still accepted as a fallback for
# existing Vercel env configurations, but new deploys should use the
# *_SIGNING_SECRET name.
LINEAR_WEBHOOK_SIGNING_SECRET=lin_wh_xxxxxxxxxxxxxxxxxxxxxxxx
# LINEAR_WEBHOOK_SECRET=  # legacy fallback — unset if SIGNING_SECRET is set

# ── Discord Webhooks & Bot ────────────────────────────────────────────────────
# Webhook URL for #builds channel — receives deploy/PR notifications.
DISCORD_BUILDS_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx

# Webhook URL for #feedback channel (optional — receives user feedback alerts).
DISCORD_FEEDBACK_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx

# Discord bot token (optional — used by src/lib/discord-bot.ts for richer feedback
# embeds + threads). Without this, the app falls back to the plain webhook.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord channel ID for the bot's feedback embeds.
DISCORD_FEEDBACK_CHANNEL_ID=your-channel-id-here

# ── PostHog Analytics ─────────────────────────────────────────────────────────
# Client-side project token (safe to expose).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxx
# Optional host override (defaults to https://app.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Server-side API key for capture events from API routes / crons.
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxx

# Personal API key for the PostHog REST API (used by daily-ops to pull insights).
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog project ID (numeric).
POSTHOG_PROJECT_ID=12345

# Signing secret for the /api/webhooks/posthog endpoint.
POSTHOG_WEBHOOK_SECRET=your-posthog-webhook-secret

# ── Microsoft Clarity (optional session replay) ───────────────────────────────
NEXT_PUBLIC_CLARITY_ID=your-clarity-id

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# From address used for outgoing email — must be a verified Resend sender.
RESEND_FROM_EMAIL=hello@pokemonvgcteamreport.com
# Operator address that receives the weekly summary digest.
SUMMARY_EMAIL=ops@pokemonvgcteamreport.com

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── App config ────────────────────────────────────────────────────────────────
# Public base URL for the deployed app — used in og:url, sitemap, email links.
NEXT_PUBLIC_APP_URL=https://pokemonvgcteamreport.com

# Comma-separated Clerk user IDs that are flagged as internal (excluded from
# growth metrics, given debug surfaces).
NEXT_PUBLIC_INTERNAL_USER_IDS=user_xxx,user_yyy
