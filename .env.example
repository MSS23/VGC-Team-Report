# ==============================================================================
# VGC Team Report — Environment Variables
# ==============================================================================
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# NEXT_PUBLIC_* vars are exposed to the browser — do not put secrets in them.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Clerk Authentication ──────────────────────────────────────────────────────
# From the Clerk Dashboard > API Keys. The publishable key is read by the Clerk
# SDK on the client; the secret key on the server. The webhook signing secret
# verifies inbound Clerk webhooks (src/app/api/webhooks/clerk).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>
CLERK_WEBHOOK_SIGNING_SECRET=<your-clerk-webhook-signing-secret>

# ── Upstash Redis (rate limiting + cache) ─────────────────────────────────────
# From the Upstash console. Both required for rate limiting and caching.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Resend (transactional email) ──────────────────────────────────────────────
# API key from resend.com. RESEND_FROM_EMAIL is the verified sender address.
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=VGC Team Report <noreply@pokemonvgcteamreport.com>
# Recipient address for cron-generated summary/digest emails
SUMMARY_EMAIL=you@example.com

# ── PostHog (product analytics + error tracking + log export) ─────────────────
# Public project token + host are used client-side and by the OTel log exporter.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side personal API key + project ID for the posthog-errors cron and the
# PostHog webhook handler. POSTHOG_API_KEY is accepted as a fallback name.
POSTHOG_PERSONAL_API_KEY=<your-posthog-personal-api-key>
# POSTHOG_API_KEY=<your-posthog-personal-api-key>   # optional fallback for the above
POSTHOG_PROJECT_ID=00000
# Shared secret validating inbound PostHog webhooks (src/app/api/webhooks/posthog)
POSTHOG_WEBHOOK_SECRET=your-posthog-webhook-secret

# ── Microsoft Clarity (session replay / heatmaps) ─────────────────────────────
# Clarity project ID (optional — analytics only)
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ── App configuration ─────────────────────────────────────────────────────────
# Canonical public origin — used for absolute URLs (e.g. OG images)
NEXT_PUBLIC_APP_URL=https://pokemonvgcteamreport.com
# Comma-separated Clerk user IDs treated as internal (excluded from analytics)
NEXT_PUBLIC_INTERNAL_USER_IDS=user_xxx,user_yyy

# ── Cron & privileged endpoints ───────────────────────────────────────────────
# Bearer token authenticating Vercel cron routes (daily-ops, weekly-report, etc.)
CRON_SECRET=your-cron-secret-here
# Token for the /api/cleanup endpoint (stale share cleanup)
CLEANUP_SECRET=your-cleanup-secret-here
# Token for the /api/setup migration endpoint (falls back to CRON_SECRET)
MIGRATE_SECRET=your-migrate-secret-here

# ── Linear Integration ────────────────────────────────────────────────────────
# Personal API key from Linear Settings > API. Used by webhook + cron routes and
# Claude Code workflows to read/update issues.
LINEAR_API_KEY=<your-linear-api-key>
# Team UUID — find via Linear API or team settings URL
LINEAR_TEAM_ID=your-team-uuid-here
# Secret verifying inbound Linear webhooks (src/app/api/webhooks/linear).
# LINEAR_WEBHOOK_SECRET is accepted as a fallback name.
LINEAR_WEBHOOK_SIGNING_SECRET=<your-linear-webhook-signing-secret>
# LINEAR_WEBHOOK_SECRET=<your-linear-webhook-signing-secret>   # optional fallback

# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token for the Discord bot route (src/app/api/bot)
DISCORD_BOT_TOKEN=your-discord-bot-token
# Channel ID the bot posts feedback into
DISCORD_FEEDBACK_CHANNEL_ID=000000000000000000
# Incoming webhook URLs for the #builds and #feedback channels
DISCORD_BUILDS_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx
DISCORD_FEEDBACK_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx
# Comma-separated allowlists authorizing mutating Discord slash-command invokers
# (user snowflake IDs and/or role IDs) — src/app/api/discord
DISCORD_ADMIN_USER_IDS=000000000000000000,111111111111111111
DISCORD_ADMIN_ROLE_IDS=000000000000000000

# Note: the Discord interaction public key is currently a hardcoded constant in
# src/app/api/discord/route.ts, not an env var, so it is intentionally omitted.
