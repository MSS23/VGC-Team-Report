# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Cron & Cleanup ────────────────────────────────────────────────────────────
# Secret for authenticating Vercel cron routes (used by health-check, stale-tickets, etc.)
CRON_SECRET=your-cron-secret-here

# Secret token for the /api/cleanup endpoint (optional — needed for stale share cleanup)
CLEANUP_SECRET=your-secret-token-here

# ── Linear Integration ────────────────────────────────────────────────────────
# API key from Linear Settings > API > Personal API Keys
# Used by Claude Code workflows to read/update issues
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Team ID — find via Linear API or team settings URL
LINEAR_TEAM_ID=your-team-uuid-here

# ── Discord Webhooks ──────────────────────────────────────────────────────────
# Webhook URL for #builds channel — receives deploy/PR notifications
DISCORD_BUILDS_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx

# Webhook URL for #feedback channel (optional — receives user feedback alerts)
# DISCORD_FEEDBACK_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx
